# Banco de desenvolvimento / piloto (não existe valor padrão no código).
DATABASE_URL=postgres://pratocheio:pratocheio@localhost:5433/pratocheio

# Banco dos testes. O nome PRECISA terminar em _test, senão os testes se recusam a rodar.
# Se omitida, vitest.config.js usa este mesmo endereço local.
TEST_DATABASE_URL=postgres://pratocheio_test:pratocheio_test@localhost:5433/pratocheio_test

# Porta do PostgreSQL no host (5433 evita conflito com um PostgreSQL local em 5432).
DB_PORT=5433

# Porta da aplicação.
PORT=3000

# Senhas usadas pelo docker compose ao CRIAR os bancos pela primeira vez.
# Em produção, troque e mantenha DATABASE_URL de acordo.
# POSTGRES_PASSWORD=pratocheio
# POSTGRES_TEST_PASSWORD=pratocheio_test